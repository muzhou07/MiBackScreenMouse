<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- root 助手通过本地 socket 与 App 通信（127.0.0.1 TCP 回环） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BackScreenMouse">

        <!-- HyperOS 背屏准入：声明后本应用的 Activity 可被投放到背屏（Display 1）。 -->
        <meta-data
            android:name="miui.rear.policy"
            android:value="1" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            触控板：纯黑界面 + 触点指示。
            exported=true + miui.rear.policy 用于通过 root 的 am start 投放（与
            MiRearScreenSwitcher / back-screen-wallpaper 做法一致，不杀进程、不改系统设置）。
        -->
        <activity
            android:name=".touchpad.TouchpadActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden|uiMode|navigation"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleInstance"
            android:taskAffinity="mz.mibackscreen.mouse.touchpad"
            android:theme="@style/Theme.BackScreenMouse.Touchpad">
            <meta-data
                android:name="miui.rear.policy"
                android:value="1" />
        </activity>

    </application>

</manifest>
