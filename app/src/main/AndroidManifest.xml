<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 检查更新（GitHub API）需要联网；与助手的通信走 App 私有目录内的 socket，不用网络 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 蓝牙鼠标模式：把本机蓝牙变成 HID 鼠标（运行时授权） -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- 蓝牙鼠标模式：自己广播 BLE 广告，主机才搜得到（运行时授权） -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BackScreenMouse">

        <!-- HyperOS 背屏准入：声明后本应用的 Activity 可被投放到背屏（Display 1）。 -->
        <meta-data
            android:name="miui.rear.policy"
            android:value="1" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            触控板：纯黑界面 + 触点指示。
            exported=false：只允许本应用与 root（su 的 am start 不受导出限制）拉起，别的 App 拉不起来。
            miui.rear.policy 用于投放（与 MiRearScreenSwitcher / back-screen-wallpaper 做法一致）。
        -->
        <activity
            android:name=".touchpad.TouchpadActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden|uiMode|navigation"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity="mz.mibackscreen.mouse.touchpad"
            android:theme="@style/Theme.BackScreenMouse.Touchpad">
            <meta-data
                android:name="miui.rear.policy"
                android:value="1" />
        </activity>

    </application>

</manifest>
